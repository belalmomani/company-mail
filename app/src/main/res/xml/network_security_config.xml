<?xml version="1.0" encoding="utf-8"?>
<!-- No cleartext traffic and no custom trust anchors: system CAs only, full certificate validation. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
